{
  "name": "spa-archive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SPA Central Archive — a GitHub Pages fan archive with Supabase auth, clearance levels, tasks and an admin console.",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=esm --outfile=assets/js/app.js --minify",
    "dev": "esbuild src/main.js --bundle --format=esm --outfile=assets/js/app.js --sourcemap --watch",
    "seed": "node scripts/seed-archives.mjs",
    "db:push": "node scripts/db-push.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
